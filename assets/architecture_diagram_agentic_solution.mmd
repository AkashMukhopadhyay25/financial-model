%% IFC CFO Office: Cloudstruck portfolio intelligence on Databricks (end-to-end architecture)
%% Read top to bottom: sources -> pipelines -> governed data -> agentic layer -> trust check -> app -> people.
flowchart TB
  classDef src fill:#eef2ff,stroke:#6b7cff,color:#1b2559
  classDef pipe fill:#f3fbf6,stroke:#3aa76d,color:#123d27
  classDef data fill:#ffffff,stroke:#7b8396,color:#1d2433
  classDef ai fill:#fff4e8,stroke:#e08a2e,color:#5a3200
  classDef ours fill:#ffe9d1,stroke:#d9731a,color:#5a3200,stroke-width:2px
  classDef app fill:#e9effd,stroke:#2f66f6,color:#0d1b4c,stroke-width:2px
  classDef people fill:#f6f7fb,stroke:#5b6378,color:#1d2433

  SRC["<b>1 · Sources</b> (monthly deliveries to a UC Volume)<br/>Project portfolio CSV (5,000) · Project monitoring CSV (3,768) · data dictionary<br/>Data contracts in Git define every column, rule and owner"]:::src

  PIPE["<b>2 · Pipelines</b>: Databricks Jobs, 01_data notebooks<br/>Schema gate (hard stop on column drift) → raw_* (history kept) → validated_* (types, quarantine, 22 DQ flags with owners)<br/>→ enriched_* (rules + ai_query LLM + reviewer overrides) → certified_* (one row per project, join on project_url)<br/>72 DQ checks: raw = validated + quarantined = certified · monthly snapshots and trends"]:::pipe

  UC["<b>3 · Unity Catalog</b>: workspace.portfolio · grants, column comments, lineage<br/>certified_investment_portfolio · certified_client_scorecard · certified_early_warning<br/>ref_assumptions A01–A24 · ref_market_outlook (cited research) · answers_register (WS1, WS2) · ws3_recommendations<br/>ops_*: DQ issues · human review queue · agent runs · agent evaluation"]:::data

  GEN["<b>Genie space</b><br/>'What happened?'<br/>plain language → SQL<br/>on the certified tables"]:::ai
  ST["<b>Reserve & Stress-Test Agent</b><br/>'What if credit worsens?'<br/>(ours)"]:::ours
  CA["<b>Capital Allocation Agent</b><br/>'Where should new money go?'<br/>(ours)"]:::ours
  CORE["<b>Shared agent core</b> (ours)<br/>tool loop · prefetched context<br/>figure tracing · consistency checks<br/>audit log"]:::ours
  TOOLS["<b>Governed tools</b><br/>deterministic SQL engines:<br/>stress scenarios · A23 ranking<br/>A24 research"]:::ai
  FM["<b>Foundation Model API</b><br/>open-weight<br/>qwen3-next-80b"]:::ai

  TRUST["<b>Trust check by code</b>: Green / Amber / Red with reasons · data-quality rows in scope counted · every figure traced to SQL"]:::ai

  APP["<b>4 · Databricks App: Cloudstruck</b> (FastAPI + React, SQL Warehouse)<br/>Overview · Portfolio analytics · Risk & exposure · Client intelligence (+ both agents) · Early warning · Monthly review · Board briefing"]:::app

  CFO["CFO Office analysts"]:::people
  BRD["Board / senior leadership"]:::people
  CRC["Credit Risk Committee<br/>human review queue"]:::people

  SRC --> PIPE --> UC
  UC --> GEN
  UC --> TOOLS
  ST --> CORE
  CA --> CORE
  CORE --> TOOLS
  CORE --> FM
  GEN --> TRUST
  CORE --> TRUST
  TRUST --> APP
  APP --> CFO
  APP --> BRD
  APP -- "send for review" --> CRC
  CRC -. "decision recorded in ops_review_requests" .-> UC
