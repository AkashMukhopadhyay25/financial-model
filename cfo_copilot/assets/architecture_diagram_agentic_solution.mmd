flowchart LR
  subgraph USERS["Business users"]
    CFO["CFO / Board<br/>finance analysts"]
    CRC["Credit Risk Committee<br/>(human review)"]
  end

  subgraph APP["Experience layer"]
    UI["Databricks App<br/>CFO Portfolio Advisor<br/>(03_demo/04_app.py)"]
  end

  subgraph AGENTS["Agentic layer (Mosaic AI)"]
    ADV["CFO Decision Advisor<br/>team-built tool-calling agent<br/>MLflow ResponsesAgent"]
    GENIE["Genie space<br/>portfolio analyst<br/>'what happened?'"]
    LLM["Foundation Model API<br/>serving endpoint"]
    TRUST["Trust layer<br/>evidence trail + review status<br/>VALIDATED / REVIEW / HUMAN REVIEW"]
  end

  subgraph TOOLS["Governed tools (Unity Catalog functions)"]
    F1["get_client_scorecard<br/>get_client_projects<br/>list_clients"]
    F2["board_risk_exposure<br/>simulate_exposure_reduction"]
    F3["get_assumptions<br/>data_quality_summary"]
  end

  subgraph DATA["Data foundation (Unity Catalog: ifc_challenge.portfolio)"]
    VOL[("Volume raw_files<br/>2 CSVs as delivered")]
    BR["bronze_projects<br/>bronze_monitoring"]
    SI["silver_projects<br/>silver_monitoring<br/>typed + DQ flags"]
    TXT["gold_project_text_features<br/>ai_query LLM + rules<br/>+ reviewer overrides"]
    GP["gold_portfolio<br/>1 row per project<br/>join on project_url"]
    GC["gold_client_scorecard<br/>1 row per client + band"]
    REF["ref_assumptions<br/>ref_region_mapping<br/>ref_product_vocabulary"]
    DQ["dq_results<br/>dq_issue_log"]
    ANS["answers_register<br/>ws3_recommendations<br/>agent_audit_log"]
  end

  subgraph OPS["Governance & operations"]
    UC["Unity Catalog<br/>grants · lineage · comments · tags"]
    MLF["MLflow<br/>tracing · evaluation · UC model registry"]
  end

  CFO --> UI --> ADV
  CFO -. ad-hoc .-> GENIE
  ADV <--> LLM
  ADV --> F1 & F2 & F3
  ADV --> GENIE
  ADV --> TRUST --> UI
  TRUST -. decisions .-> CRC
  F1 & F2 --> GC
  F1 & F2 --> GP
  F3 --> REF & DQ
  GENIE --> GP & GC & REF
  VOL -->|multiLine CSV read| BR -->|type · standardise · flag| SI
  SI --> TXT
  SI --> GP
  TXT --> GP --> GC
  REF --> SI
  SI --> DQ
  ADV --> ANS
  UC -. governs .- DATA
  UC -. governs .- TOOLS
  MLF -. traces & evaluates .- ADV
